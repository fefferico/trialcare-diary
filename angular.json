{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "trialcare-diary": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "tc",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "css",
            "styles": [
              "src/styles.css"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "pdf.worker.min.mjs",
                "input": "node_modules/pdfjs-dist/legacy/build",
                "output": "assets/pdfjs/"
              },
              {
                "glob": "*.wasm",
                "input": "node_modules/pdfjs-dist/wasm",
                "output": "assets/pdfjs/wasm/"
              },
              {
                "glob": "*_nowasm_fallback.js",
                "input": "node_modules/pdfjs-dist/wasm",
                "output": "assets/pdfjs/wasm/"
              },
              {
                "glob": "worker.min.js",
                "input": "node_modules/tesseract.js/dist",
                "output": "assets/tesseract/"
              },
              {
                "glob": "tesseract-core*.js",
                "input": "node_modules/tesseract.js-core",
                "output": "assets/tesseract/core/"
              },
              {
                "glob": "tesseract-core*.wasm",
                "input": "node_modules/tesseract.js-core",
                "output": "assets/tesseract/core/"
              }
            ],
            "outputPath": "dist/trialcare-diary"
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.pages.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "20kb",
                  "maximumError": "50kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "trialcare-diary:build:production"
            },
            "development": {
              "buildTarget": "trialcare-diary:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}